{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Decibel",
  "version": "0.1.0",
  "identifier": "com.decibel.harness",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Decibel",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
